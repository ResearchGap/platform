{
  "name": "@platform/db",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "bun": "./src/*.ts",
      "import": "./dist/src/*.js",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "db:push": "bunx --bun prisma db push",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:migrate:deploy": "bunx --bun prisma migrate deploy",
    "db:studio": "bunx --bun prisma studio",
    "db:validate": "bunx --bun prisma validate",
    "format": "biome format --config-path ../../biome.json --write src prisma.config.ts package.json tsconfig.json tsconfig.build.json",
    "format:check": "biome format --config-path ../../biome.json src prisma.config.ts package.json tsconfig.json tsconfig.build.json",
    "lint": "biome lint --config-path ../../biome.json src prisma.config.ts package.json tsconfig.json tsconfig.build.json",
    "postinstall": "bunx --bun prisma generate"
  },
  "dependencies": {
    "@platform/env": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "catalog:",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@platform/config": "workspace:*",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.1",
    "typescript": "catalog:"
  }
}
