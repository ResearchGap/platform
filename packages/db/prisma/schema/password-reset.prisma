enum PasswordResetSource {
  SELF_SERVICE
  SUPPORT

  @@map("password_reset_source")
}

enum PasswordResetDeliveryMode {
  EMAIL
  MANUAL

  @@map("password_reset_delivery_mode")
}

enum PasswordResetStatus {
  REQUESTED
  NO_ACCOUNT
  EMAIL_SENT
  DELIVERY_FAILED
  MANUAL_READY
  COMPLETED

  @@map("password_reset_status")
}

model PasswordResetRequest {
  id                     String                    @id @default(cuid())
  requestedEmail         String                    @map("requested_email")
  userId                 String?                   @map("user_id")
  source                 PasswordResetSource
  deliveryMode           PasswordResetDeliveryMode @map("delivery_mode")
  status                 PasswordResetStatus       @default(REQUESTED)
  requestedAt            DateTime                  @default(now()) @map("requested_at") @db.Timestamptz(3)
  expiresAt              DateTime?                 @map("expires_at") @db.Timestamptz(3)
  emailSentAt            DateTime?                 @map("email_sent_at") @db.Timestamptz(3)
  completedAt            DateTime?                 @map("completed_at") @db.Timestamptz(3)
  ipAddress              String?                   @map("ip_address")
  userAgent              String?                   @map("user_agent")
  resetUrlEncrypted      String?                   @map("reset_url_encrypted") @db.Text
  manuallyRevealedAt     DateTime?                 @map("manually_revealed_at") @db.Timestamptz(3)
  manuallyRevealedById   String?                   @map("manually_revealed_by_id")
  requestedById          String?                   @map("requested_by_id")
  safeDeliveryError      String?                   @map("safe_delivery_error")
  user                   User?                     @relation("PasswordResetTarget", fields: [userId], references: [id], onDelete: SetNull)
  manuallyRevealedBy     User?                     @relation("PasswordResetRevealer", fields: [manuallyRevealedById], references: [id], onDelete: SetNull)
  requestedBy            User?                     @relation("PasswordResetRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([requestedEmail])
  @@index([userId])
  @@index([requestedAt])
  @@index([status])
  @@index([ipAddress, requestedAt])
  @@index([userId, requestedAt])
  @@index([manuallyRevealedById])
  @@index([requestedById])
  @@map("password_reset_requests")
}
