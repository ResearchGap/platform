{
  "name": "@platform/env",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": {
      "types": "./src/server.ts",
      "bun": "./src/server.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./password-reset": {
      "types": "./src/password-reset.ts",
      "bun": "./src/password-reset.ts",
      "import": "./dist/password-reset.js",
      "default": "./dist/password-reset.js"
    },
    "./web": {
      "types": "./src/web.ts",
      "bun": "./src/web.ts",
      "import": "./dist/web.js",
      "default": "./dist/web.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "format": "biome format --config-path ../../biome.json --write src package.json tsconfig.json tsconfig.build.json",
    "format:check": "biome format --config-path ../../biome.json src package.json tsconfig.json tsconfig.build.json",
    "lint": "biome lint --config-path ../../biome.json src package.json tsconfig.json tsconfig.build.json"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "@t3-oss/env-nextjs": "^0.13.11",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@platform/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
