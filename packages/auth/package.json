{
  "name": "@platform/auth",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "format": "biome format --config-path ../../biome.json --write .",
    "format:check": "biome format --config-path ../../biome.json .",
    "lint": "biome lint --config-path ../../biome.json ."
  },
  "dependencies": {
    "@platform/db": "workspace:*",
    "@platform/env": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@platform/config": "workspace:*",
    "typescript": "catalog:"
  }
}
