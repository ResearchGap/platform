{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "format": "biome format --config-path ../../biome.json --write src package.json tsconfig.json tsdown.config.ts",
    "format:check": "biome format --config-path ../../biome.json src package.json tsconfig.json tsdown.config.ts",
    "lint": "biome lint --config-path ../../biome.json src package.json tsconfig.json tsdown.config.ts",
    "start": "bun run dist/index.mjs",
    "test": "bun test"
  },
  "dependencies": {
    "@platform/auth": "workspace:*",
    "@platform/db": "workspace:*",
    "@platform/env": "workspace:*",
    "better-auth": "catalog:",
    "cors": "^2.8.6",
    "dotenv": "catalog:",
    "express": "^5.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@platform/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  },
  "trustedDependencies": [
    "supabase"
  ]
}
